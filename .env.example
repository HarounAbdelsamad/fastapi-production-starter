# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# "sqlite+aiosqlite:///dev.db" for local dev (zero setup)
# "postgresql+asyncpg://user:pass@localhost:5432/mydb" for production
DATABASE_URL=sqlite+aiosqlite:///dev.db

# Used for signing tokens, cookies, etc. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-secret

# Application
APP_ENV=development
DEBUG=true
