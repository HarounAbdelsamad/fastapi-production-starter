# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# "sqlite+aiosqlite:///dev.db" for local dev (zero setup)
# "postgresql+asyncpg://user:pass@localhost:5432/mydb" for production
DATABASE_URL=sqlite+aiosqlite:///dev.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# Used for signing tokens, cookies, etc. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-secret

# Application
APP_ENV=development
DEBUG=true
SCALE_TIER=basic

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=15
TOKEN_REVOCATION_ENABLED=true

CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["Authorization","Content-Type"]
TRUSTED_HOSTS=["*"]

AUTO_CREATE_TABLES=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=false
CACHE_DEFAULT_TTL=300

CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_ENABLED=false

MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
FRONTEND_URL=http://localhost:3000
